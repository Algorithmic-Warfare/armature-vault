build/
# Sui Move auto-generates Move.lock on every build/test. Historically this repo
# has not tracked it (PRs #2/#6/#7 all merged without it). Ignoring explicitly
# here so reviewers don't see "untracked lockfile" warnings on PRs and start
# worrying about manifest/lock drift; the manifest is the canonical pin source.
Move.lock

# Move coverage reports (scripts/move_coverage.py)
coverage/

# Gas harness state (scripts/gas_harness.py)
.gas-harness/

# Stray CLI output, such as a failed `sui client publish` saved to test.log
test.log
